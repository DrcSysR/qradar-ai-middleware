SELECT
    LOGSOURCENAME(logsourceid) AS Host,
    "Process Name" AS Proc,
    "Process Path" AS Proc_Path,
    QIDNAME(qid) AS Activity,
    username AS Acct,
    COUNT(*) AS Events
FROM events
WHERE
    INOFFENSE({offense_id})
    -- BENIGN PRE-FILTER. Правило спрацьовує на будь-якому софті, що пише реєстр і створює
    -- файли: оновлювачі, інсталятори, 1С, месенджери, сам EDR. Це 100% спостережуваного
    -- обсягу (224 офенси за 12 год). Фільтруємо ЛИШЕ за парою «ім'я процесу + шлях»; там,
    -- де Sysmon шлях не дав (RegistryEvent), приймаємо NULL — інакше відфільтрується все.
    -- УВАГА: у шаблонах НЕ використовуємо зворотні слеші. AQL не екранує їх, тож '\\Microsoft\\'
    -- шукає два слеші поспіль і не збігається ніколи — на цьому вже спіткнулись при написанні.
    AND NOT ("Process Name" ILIKE 'OneDrive%'
             AND ("Process Path" IS NULL OR "Process Path" ILIKE '%Microsoft%OneDrive%'))
    AND NOT ("Process Name" ILIKE 'MicrosoftEdgeUpdate%'
             AND ("Process Path" IS NULL OR "Process Path" ILIKE '%EdgeUpdate%'))
    AND NOT ("Process Name" ILIKE 'msedge.exe'
             AND ("Process Path" IS NULL OR "Process Path" ILIKE '%Microsoft%Edge%'))
    AND NOT ("Process Name" ILIKE '%chrome_installer%'
             AND ("Process Path" IS NULL OR "Process Path" ILIKE '%SystemTemp%'))
    AND NOT ("Process Name" ILIKE '1cv8%'
             AND ("Process Path" IS NULL OR "Process Path" ILIKE '%1cv8%'))
    AND NOT ("Process Name" ILIKE 'Viber.exe'
             AND ("Process Path" IS NULL OR "Process Path" ILIKE '%AppData%Viber%'))
    AND NOT ("Process Name" ILIKE 'CSFalcon%'
             AND ("Process Path" IS NULL OR "Process Path" ILIKE '%CrowdStrike%'))
    AND NOT ("Process Name" ILIKE 'OCSInventory%'
             AND ("Process Path" IS NULL OR "Process Path" ILIKE '%OCS Inventory%'))
    -- SOLIDWORKS PDM: NetRegSrv/AddInRegSrv реєструють .NET-COM CLSID (InprocServer32 =
    -- mscoree.dll) у кущі кожного користувача при логоні. Десятки RegistryEvent за раз,
    -- на всіх конструкторських машинах. Підтверджено на cns130/CNS131 26.08.2026.
    AND NOT ("Process Name" ILIKE 'NetRegSrv.exe'
             AND ("Process Path" IS NULL OR "Process Path" ILIKE '%SOLIDWORKS%'))
    AND NOT ("Process Name" ILIKE 'AddInRegSrv%'
             AND ("Process Path" IS NULL OR "Process Path" ILIKE '%SOLIDWORKS%'))
    -- Windows AppCompat: sdbinst пише FriendlyName для sysmain.sdb/msimain.sdb після
    -- кумулятивного оновлення. Windows-maintenance таски дають погодинну каденцію.
    AND NOT ("Process Name" ILIKE 'sdbinst.exe'
             AND ("Process Path" IS NULL OR "Process Path" ILIKE '%System32%'))
    AND NOT ("Process Name" ILIKE 'Microsoft.Data.UsageAndQualityInsights%'
             AND ("Process Path" IS NULL OR "Process Path" ILIKE '%System32%'))
    AND NOT ("Process Name" ILIKE 'CompatTelRunner.exe'
             AND ("Process Path" IS NULL OR "Process Path" ILIKE '%System32%'))
    -- Claude (десктоп-застосунок і Claude Code CLI): ~20 робочих станцій, кожен інстанс
    -- per-user. Подія-тригер тут — «A process changed a file creation time», і саме на ній
    -- Sysmon шляху НЕ дає, тому NULL приймаємо (як в OneDrive вище). Виміряно 27.08.2026:
    -- чотири форми встановлення, усі під профілем користувача. Підроблений claude.exe із
    -- Temp/ProgramData має непорожній шлях, під жоден патерн не підпадає і лишається видимим.
    AND NOT ("Process Name" ILIKE 'claude.exe'
             AND ("Process Path" IS NULL
                  OR "Process Path" ILIKE '%AnthropicClaude%'          -- десктоп-застосунок
                  OR "Process Path" ILIKE '%anthropic-ai%claude-code%' -- npm / nvm
                  OR "Process Path" ILIKE '%anthropic.claude-code%'    -- розширення VS Code
                  OR "Process Path" ILIKE '%Claude%claude-code%'       -- AppData Roaming Claude і MS Store
                  OR "Process Path" ILIKE '%Users%.local%bin%claude.exe%'))
    -- Squirrel-апдейтер десктопного Claude. Ім'я Update.exe носять десятки застосунків і
    -- чимало малварі, тож NULL тут НЕ приймаємо — тільки явний шлях під AnthropicClaude.
    AND NOT ("Process Name" ILIKE 'Update.exe'
             AND "Process Path" ILIKE '%AnthropicClaude%')
    -- Opera (браузер): пише .tmp у свій профіль і чіпає час створення (T1099) → «File Decode
    -- followed by Suspicious Activity». 165/172 подій офенса на fem16; повторюється PRP20/INS32.
    -- Анкор на КАТАЛОГ Opera (профіль або Programs\Opera), НЕ на ім'я файлу — фейковий opera.exe
    -- із Temp має шлях %Temp%opera.exe, під ці каталоги не підпадає і лишається видимим.
    AND NOT ("Process Name" ILIKE 'opera.exe'
             AND ("Process Path" IS NULL
                  OR "Process Path" ILIKE '%Opera Software%'
                  OR "Process Path" ILIKE '%Programs%Opera%'))
    -- Opera Assistant installer — тільки зі свого розпакування %Temp%\.opera\ (NULL НЕ приймаємо).
    AND NOT ("Process Name" ILIKE 'assistant_installer.exe'
             AND "Process Path" ILIKE '%Temp%.opera%')
    -- Telegram Desktop: оновлює jump-list у ...\Recent → «mass file creation time» (T1099). PEC27 15.09.
    AND NOT ("Process Name" ILIKE 'Telegram.exe'
             AND ("Process Path" IS NULL OR "Process Path" ILIKE '%Telegram Desktop%'))
    -- Windows servicing (Modules Installer / DISM): TiWorker/DismHost/poqexec міняють ImagePath
    -- служб і пишуть у Temp під час кумулятивних оновлень → тригерять Ransomware / Service Binary
    -- Path Changed. Підтверджено на WIN-5II4TGNJIB9 та RDGW 13-14.09 (той самий Patch-цикл).
    AND NOT ("Process Name" ILIKE 'TiWorker.exe'
             AND ("Process Path" IS NULL OR "Process Path" ILIKE '%winsxs%' OR "Process Path" ILIKE '%servicing%'))
    AND NOT ("Process Name" ILIKE 'DismHost.exe'
             AND ("Process Path" IS NULL OR "Process Path" ILIKE '%Windows%Temp%' OR "Process Path" ILIKE '%System32%'))
    AND NOT ("Process Name" ILIKE 'poqexec.exe'
             AND ("Process Path" IS NULL OR "Process Path" ILIKE '%System32%'))
    -- Opera autoupdate: opera_autoupdate.exe запускає installer.exe із свого розпакування
    -- %Temp%\.opera\<rand>\installer.exe (Description=Opera Installer, Company=Opera Software).
    -- Наявний фільтр вище ловив лише opera.exe і assistant_installer.exe — а саме цей
    -- installer.exe/opera_autoupdate.exe прослизали і давали «temp-dir process» на drt34 (#1385189)
    -- та file-decode на SMQ/INS. Анкор на самозапаковку .opera (NULL для installer НЕ приймаємо).
    AND NOT ("Process Name" ILIKE 'installer.exe'
             AND "Process Path" ILIKE '%Temp%.opera%')
    AND NOT ("Process Name" ILIKE 'opera_autoupdate.exe'
             AND ("Process Path" IS NULL
                  OR "Process Path" ILIKE '%Opera%'
                  OR "Process Path" ILIKE '%Programs%Opera%'))
    -- Chrome Platform Experience Helper: фоновий хелпер Chrome, запускається svchost -k netsvcs
    -- Schedule. Підписаний Google, живе під Program Files\Google\Chrome. Давав «rundll32 C2»/
    -- file-decode шум на REF12 (#1381044).
    AND NOT ("Process Name" ILIKE 'platform_experience_helper.exe'
             AND ("Process Path" IS NULL OR "Process Path" ILIKE '%Google%Chrome%'))
    -- OneDrive launcher (окреме ім'я від OneDrive.exe вище): стартує інстанси по scheduled task.
    AND NOT ("Process Name" ILIKE 'OneDriveLauncher.exe'
             AND ("Process Path" IS NULL OR "Process Path" ILIKE '%OneDrive%'))
    -- YourPhone / Phone Link: PhoneExperienceHost.exe із WindowsApps, запуск через DCOM.
    AND NOT ("Process Name" ILIKE 'PhoneExperienceHost.exe'
             AND ("Process Path" IS NULL
                  OR "Process Path" ILIKE '%YourPhone%'
                  OR "Process Path" ILIKE '%WindowsApps%'))
    -- Autodesk AutoCAD «Activity Insights»: AcEventSync.exe (батько accoreconsole.exe) пише у
    -- AppData\Local\Autodesk\ActivityInsights → «File Decode followed by Suspicious Activity».
    -- Підписаний Autodesk, на конструкторських машинах (HRD79 #1392450 17.09).
    AND NOT ("Process Name" ILIKE 'AcEventSync.exe'
             AND ("Process Path" IS NULL OR "Process Path" ILIKE '%Autodesk%'))
    -- Adobe Acrobat collaboration sync: AdobeCollabSync.exe із Program Files\Adobe\Acrobat.
    AND NOT ("Process Name" ILIKE 'AdobeCollabSync.exe'
             AND ("Process Path" IS NULL OR "Process Path" ILIKE '%Adobe%Acrobat%'))
GROUP BY Host, Proc, Proc_Path, Activity, Acct
ORDER BY Events DESC
LIMIT {limit} {time_depth}
