SELECT
    sourceip AS Src_Host,
    destinationip AS DNS_Dst,
    -- Історія рішення. Версія 1 виключала публічні резолвери в WHERE. Версія 2 (серпень)
    -- замість цього КЛАСИФІКУВАЛА їх як 'public-resolver', щоб модель сама зважила
    -- policy-bypass. Замір 24.09.2026 за добу конвеєра: 216 LLM-викликів цієї лінзи, з них
    -- 210 — вердикт DNS_Unlisted_Resolver ≤0.55, усі авто-закриті. Тобто класифікація
    -- купувала лише нотатку в закритому офенсі ціною інференсу. Версія 3 (ця): відомі
    -- публічні/ISP-резолвери знову відсікаємо в WHERE (нижче), а класу 'public-resolver'
    -- більше немає. Модель бачить лише 'internal-unlisted' (кандидат у рефсет) і
    -- 'unclassified' (довільний інтернет-хост на 53 — єдиний справжній сигнал: тунелювання,
    -- C2, misconfig) — плюс Bytes_Per_Query для тунелювання. Порожньо → close_on_empty 0.0.
    -- Свідомий компроміс: тунелювання ЧЕРЕЗ 8.8.8.8/1.1.1.1 тут не побачимо (єдиний такий
    -- кейс, 192.168.22.19, виявився артефактом PA session-aggregation на CCTV VMS).
    CASE
        WHEN REFERENCESETCONTAINS('UC05-DNS Servers', destinationip) THEN 'corporate'
        WHEN INCIDR('10.0.0.0/8', destinationip) OR INCIDR('172.16.0.0/12', destinationip)
             OR INCIDR('192.168.0.0/16', destinationip) THEN 'internal-unlisted'
        ELSE 'unclassified'
    END AS Server_Class,
    NETWORKNAME(sourceip) AS Src_Network,
    -- "Application" свідомо НЕ беремо: властивість заповнена не на всіх подіях, і групування
    -- за нею розщеплювало кожну пару на два рядки, у порожньому з них Bytes_Per_Query=0.
    COUNT(*) AS Queries,
    -- Байти на запит лишаємо КОЛОНКОЮ, а не фільтром. Звичайний DNS ~80-160 Б; стабільно
    -- 300+ на великому обсязі — підпис тунелювання. Як HAVING-фільтр це відсікало все інше.
    SUM("Bytes Sent")/COUNT(*) AS Bytes_Per_Query,
    (MAX(starttime) - MIN(starttime))/1000 AS Span_Sec
FROM events
WHERE
    INOFFENSE({offense_id})
    AND destinationport = 53
    -- Джерела-резолвери беремо з того самого рефсету, що й правило: набір змінюється в
    -- одному місці, AQL і правило не розходяться. Наш DC, що форвардить нагору, — не порушник.
    AND NOT REFERENCESETCONTAINS('UC05-DNS Servers', sourceip)
    -- Відомі публічні та ISP-резолвери — policy-bypass, не безпека (див. коментар до CASE).
    -- Google, Cloudflare, Quad9, OpenDNS, AliDNS (+anycast), Tencent, 114DNS, Yandex, AdGuard,
    -- і ISP-резолвери, що повторюються у нашому середовищі: Люблін на Play/Tucows, телефони на
    -- Vodafone (підтверджено в хендофі 09.09.2026).
    AND destinationip NOT IN ('8.8.8.8','8.8.4.4','1.1.1.1','1.0.0.1','9.9.9.9','149.112.112.112',
                              '208.67.222.222','208.67.220.220','223.5.5.5','223.6.6.6',
                              '119.29.29.29','114.114.114.114','77.88.8.8','77.88.8.1',
                              '94.140.14.14','94.140.15.15','100.100.100.100',
                              '193.47.158.254','193.47.158.255','216.40.47.90','80.255.64.23')
GROUP BY Src_Host, DNS_Dst, Server_Class, Src_Network
ORDER BY Queries DESC
LIMIT {limit} {time_depth}
