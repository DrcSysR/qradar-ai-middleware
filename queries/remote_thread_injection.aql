SELECT
    LOGSOURCENAME(logsourceid) AS Hostname,
    "Process Name" AS Injector,
    "Process Path" AS Injector_Path,
    "Target Process Name" AS Target_Proc,
    "Target Process Path" AS Target_Path,
    username AS Acct,
    COUNT(*) AS Events
FROM events
WHERE
    INOFFENSE({offense_id})
    -- УВАГА по аліасах: Target і User — зарезервовані слова, QRadar на них віддає
    -- ParseError 28508 без номера рядка. Звідси Target_Proc / Acct.
    --
    -- Самі CRE-події (Process Created a Thread into ...) не несуть імен процесів —
    -- усе корисне лежить у Sysmon EventID 8. Беремо тільки їх.
    AND QIDNAME(qid) ILIKE '%CreateRemoteThread%'
    -- BENIGN PRE-FILTER. За добу по організації CreateRemoteThread дає ~2300 подій, з них
    -- rdpclip-csrss (1218) + dwm-csrss (474) + Autodesk (376) — це 90% обсягу і 100% шуму.
    -- Пари матчимо РАЗОМ зі шляхом інжектора: підробка з іменем dwm.exe, запущена з Temp,
    -- фільтр не пройде і дійде до аналізу.
    AND NOT ("Process Name" ILIKE 'rdpclip.exe' AND "Process Path" ILIKE '%ystem32%' AND "Target Process Name" ILIKE 'csrss.exe')
    AND NOT ("Process Name" ILIKE 'dwm.exe' AND "Process Path" ILIKE '%ystem32%' AND "Target Process Name" ILIKE 'csrss.exe')
    AND NOT ("Process Name" ILIKE 'SystemSettings.exe' AND "Process Path" ILIKE '%ImmersiveControlPanel%')
    AND NOT ("Process Name" ILIKE 'AdskAccessServiceHost.exe' AND "Process Path" ILIKE '%Autodesk%')
    AND NOT ("Process Name" ILIKE 'Code.exe' AND "Target Process Name" ILIKE 'Code.exe')
    AND NOT ("Process Name" ILIKE 'WerFault.exe' AND "Process Path" ILIKE '%ystem32%')
    -- Sysmon читає lsass легітимно; будь-який ІНШИЙ інжектор у lsass.exe навмисно лишається.
    AND NOT ("Process Name" ILIKE 'Sysmon64.exe' AND "Process Path" ILIKE '%Windows%')
    AND NOT ("Process Name" ILIKE 'OcsService.exe' AND "Process Path" ILIKE '%OCS Inventory%')
    -- Агент Cortex XDR (розгорнутий 12.10.2026 на ~650 хостів): cyserver.exe штатно інжектить
    -- у lsass/svchost (захист пам'яті), payload і VAScanner — у невідомі процеси. 137 офенсів
    -- за 2 тижні з вердиктом «Confirmed Credential Access». Шляхи захищені ACL агента —
    -- користувач туди не покладе файл; cyserver.exe з будь-якого ІНШОГО місця лишається.
    AND NOT ("Process Name" ILIKE 'cyserver.exe' AND "Process Path" ILIKE '%Program Files%Palo Alto Networks%Traps%')
    AND NOT ("Process Name" ILIKE 'cortex-xdr-payload.exe' AND "Process Path" ILIKE '%ProgramData%Cyvera%LocalSystem%')
    AND NOT ("Process Name" ILIKE 'VAScanner.exe' AND "Process Path" ILIKE '%ProgramData%Cyvera%LocalSystem%')
    -- SOLIDWORKS eDrawings зі штатної інсталяції (40 хостів). Копії з %TEMP%\EMO*\ НЕ фільтруємо —
    -- Temp пише користувач; їх розбирає промпт.
    AND NOT ("Process Name" ILIKE 'EModelViewer.exe' AND "Process Path" ILIKE '%Program Files%eDrawings%')
    -- Sysmon часто не резолвить ціль і пише Target Process Path = unknown process. Для
    -- браузерів і шелу це їхня внутрішня пісочниця — ~130 подій/добу без жодного сигналу
    -- (цілі не видно, аналізувати нема що). Знімаємо ЛИШЕ для цих інжекторів: нерозпізнана
    -- ціль у RustDesk чи невідомого процесу лишається видимою.
    AND NOT ("Target Process Path" ILIKE '%unknown process%' AND "Process Name" ILIKE 'chrome.exe')
    AND NOT ("Target Process Path" ILIKE '%unknown process%' AND "Process Name" ILIKE 'msedge.exe')
    AND NOT ("Target Process Path" ILIKE '%unknown process%' AND "Process Name" ILIKE 'dwm.exe')
    AND NOT ("Target Process Path" ILIKE '%unknown process%' AND "Process Name" ILIKE 'explorer.exe')
    -- Opera / Opera GX ставляться в профіль користувача (AppData\Local\Programs\Opera*) — та сама
    -- пісочниця, що й у Chrome, ~40 тис. подій за 2 тижні. Лише ціль «unknown process» і лише з
    -- рідного каталогу: opera.exe з Temp чи в іменовану ціль (lsass тощо) лишається видимим.
    AND NOT ("Target Process Path" ILIKE '%unknown process%' AND "Process Name" ILIKE 'opera.exe' AND "Process Path" ILIKE '%AppData%Local%Programs%Opera%')
    -- 17.11.2026: черга CreateRemoteThread не встигала (приплив 500-900 офенсів/год проти ~550/год
    -- дренажу). За 2 год ~3000 подій із цілі «unknown process» від штатного ПЗ — аналізувати нема
    -- чого (Sysmon не резолвить ціль). Знімаємо ЛИШЕ пару «рідний шлях + нерозпізнана ціль»:
    -- той самий ін'єктор з Temp/AppData чи в іменовану ціль (lsass тощо) лишається видимим.
    -- GlobalProtect HIP-перевірка (270 хостів, ~1900 подій/2 год).
    AND NOT ("Target Process Path" ILIKE '%unknown process%' AND "Process Name" ILIKE 'PanGpHip.exe' AND "Process Path" ILIKE '%Program Files%Palo Alto Networks%GlobalProtect%')
    -- 1С:Підприємство.
    AND NOT ("Target Process Path" ILIKE '%unknown process%' AND ("Process Name" ILIKE '1cv8.exe' OR "Process Name" ILIKE '1cv8c.exe') AND "Process Path" ILIKE '%Program Files%1cv8%')
    -- OCS Inventory (службу OcsService.exe знято вище, сам агент — тут).
    AND NOT ("Target Process Path" ILIKE '%unknown process%' AND "Process Name" ILIKE 'OCSInventory.exe' AND "Process Path" ILIKE '%Program Files%OCS Inventory Agent%')
    -- RustDesk — санкціонований віддалений доступ (корпоративний сервер gw2).
    AND NOT ("Target Process Path" ILIKE '%unknown process%' AND "Process Name" ILIKE 'RustDesk.exe' AND "Process Path" ILIKE '%Program Files%RustDesk%')
    -- Adobe Acrobat / Reader (пісочниця захищеного режиму).
    AND NOT ("Target Process Path" ILIKE '%unknown process%' AND ("Process Name" ILIKE 'Acrobat.exe' OR "Process Name" ILIKE 'AcroRd32.exe') AND "Process Path" ILIKE '%Program Files%Adobe%')
    -- Штатні процеси входу/друку Windows зі System32.
    AND NOT ("Target Process Path" ILIKE '%unknown process%' AND ("Process Name" ILIKE 'userinit.exe' OR "Process Name" ILIKE 'LogonUI.exe') AND "Process Path" ILIKE '%ystem32%')
    AND NOT ("Target Process Path" ILIKE '%unknown process%' AND "Process Name" ILIKE 'splwow64.exe' AND "Process Path" ILIKE '%Windows%')
    -- 19.11.2026 (розвантаження tier-1): після попередніх фільтрів ~3800 офенсів/добу йшли в модель, і
    -- майже всі рядки мали ціль «unknown process» — Sysmon не резолвить, куди вставлено потік, тож
    -- аналізувати нема чого (модель повертала 0.0-0.4 і закривала). Знімаємо ЛИШЕ пару «нерозпізнана
    -- ціль + рідний каталог інжектора». Той самий бінарник з Temp/Downloads/іншого шляху лишається
    -- видимим (кожна пара додатково відсікає шляхи з Temp/Downloads); названі цілі (lsass, cmd тощо) не чіпаємо взагалі. CSFalconService.exe навмисно НЕ тут
    -- (Falcon виводиться, хочемо бачити залишки).
    AND NOT ("Target Process Path" ILIKE '%unknown process%' AND ("Process Name" ILIKE 'cmd.exe' OR "Process Name" ILIKE 'powershell.exe' OR "Process Name" ILIKE 'CompatTelRunner.exe' OR "Process Name" ILIKE 'gpscript.exe' OR "Process Name" ILIKE 'mstsc.exe' OR "Process Name" ILIKE 'msiexec.exe' OR "Process Name" ILIKE 'igfxCUIService.exe') AND "Process Path" ILIKE '%ystem32%' AND NOT ("Process Path" ILIKE '%Temp%' OR "Process Path" ILIKE '%Downloads%'))
    AND NOT ("Target Process Path" ILIKE '%unknown process%' AND "Process Name" ILIKE 'bash.exe' AND "Process Path" ILIKE '%Git%usr%bin%' AND NOT ("Process Path" ILIKE '%Temp%' OR "Process Path" ILIKE '%Downloads%'))
    AND NOT ("Target Process Path" ILIKE '%unknown process%' AND "Process Name" ILIKE 'node.exe' AND ("Process Path" ILIKE '%Program Files%nodejs%' OR "Process Path" ILIKE '%AppData%nvm%') AND NOT ("Process Path" ILIKE '%Temp%' OR "Process Path" ILIKE '%Downloads%'))
    AND NOT ("Target Process Path" ILIKE '%unknown process%' AND "Process Name" ILIKE 'py.exe' AND "Process Path" ILIKE '%AppData%Local%Programs%Python%' AND NOT ("Process Path" ILIKE '%Temp%' OR "Process Path" ILIKE '%Downloads%'))
    AND NOT ("Target Process Path" ILIKE '%unknown process%' AND "Process Name" ILIKE 'pycharm64.exe' AND "Process Path" ILIKE '%PyCharm%' AND NOT ("Process Path" ILIKE '%Temp%' OR "Process Path" ILIKE '%Downloads%'))
    AND NOT ("Target Process Path" ILIKE '%unknown process%' AND "Process Name" ILIKE 'claude.exe' AND "Process Path" ILIKE '%native-binary%' AND NOT ("Process Path" ILIKE '%Temp%' OR "Process Path" ILIKE '%Downloads%'))
    AND NOT ("Target Process Path" ILIKE '%unknown process%' AND "Process Name" ILIKE 'oscript.exe' AND "Process Path" ILIKE '%OneScript%' AND NOT ("Process Path" ILIKE '%Temp%' OR "Process Path" ILIKE '%Downloads%'))
    AND NOT ("Target Process Path" ILIKE '%unknown process%' AND "Process Name" ILIKE 'firefox.exe' AND "Process Path" ILIKE '%Mozilla Firefox%' AND NOT ("Process Path" ILIKE '%Temp%' OR "Process Path" ILIKE '%Downloads%'))
    AND NOT ("Target Process Path" ILIKE '%unknown process%' AND "Process Name" ILIKE 'zabbix_agentd.exe' AND "Process Path" ILIKE '%Program Files%Zabbix Agent%' AND NOT ("Process Path" ILIKE '%Temp%' OR "Process Path" ILIKE '%Downloads%'))
    AND NOT ("Target Process Path" ILIKE '%unknown process%' AND ("Process Name" ILIKE 'AdobeARM.exe' OR "Process Name" ILIKE 'acrobat_sl.exe') AND "Process Path" ILIKE '%Program Files%Adobe%' AND NOT ("Process Path" ILIKE '%Temp%' OR "Process Path" ILIKE '%Downloads%'))
    AND NOT ("Target Process Path" ILIKE '%unknown process%' AND "Process Name" ILIKE 'PanGPS.exe' AND "Process Path" ILIKE '%Program Files%Palo Alto Networks%GlobalProtect%' AND NOT ("Process Path" ILIKE '%Temp%' OR "Process Path" ILIKE '%Downloads%'))
    AND NOT ("Target Process Path" ILIKE '%unknown process%' AND "Process Name" ILIKE 'SLDWORKS.exe' AND "Process Path" ILIKE '%Program Files%SOLIDWORKS%' AND NOT ("Process Path" ILIKE '%Temp%' OR "Process Path" ILIKE '%Downloads%'))
    AND NOT ("Target Process Path" ILIKE '%unknown process%' AND "Process Name" ILIKE 'notification_helper.exe' AND "Process Path" ILIKE '%Google%Chrome%Application%' AND NOT ("Process Path" ILIKE '%Temp%' OR "Process Path" ILIKE '%Downloads%'))
    AND NOT ("Target Process Path" ILIKE '%unknown process%' AND "Process Name" ILIKE 'BlueStacksServices.exe' AND "Process Path" ILIKE '%Local%Programs%bluestacks-services%' AND NOT ("Process Path" ILIKE '%Temp%' OR "Process Path" ILIKE '%Downloads%'))
    AND NOT ("Target Process Path" ILIKE '%unknown process%' AND "Process Name" ILIKE 'erl.exe' AND "Process Path" ILIKE '%ProgramData%Biesse%' AND NOT ("Process Path" ILIKE '%Temp%' OR "Process Path" ILIKE '%Downloads%'))
GROUP BY Hostname, Injector, Injector_Path, Target_Proc, Target_Path, Acct
ORDER BY Events DESC
LIMIT {limit} {time_depth}
