SELECT
    LOGSOURCENAME(logsourceid) AS Host,
    "Process Path" AS Proc_Path,
    destinationip AS Dst,
    destinationport AS Dport,
    username AS Acct,
    COUNT(*) AS Conns
FROM events
WHERE
    INOFFENSE({offense_id})
    -- Правило зветься "Outbound", але спрацьовує і на ВНУТРІШНІ призначення. Уся корисна
    -- телеметрія лежить у Sysmon EventID 3; сама CRE-подія дублює поля без хоста й юзера,
    -- тому беремо лише реальний endpoint-івент.
    AND QIDNAME(qid) ILIKE '%Network connection detected%'
    AND "Process Name" ILIKE 'rundll32.exe'
    AND (
        -- ГІЛКА 1: МАСКУЮЧИЙ бінарник — тримаємо видимим за БУДЬ-ЯКОГО призначення (навіть
        -- внутрішнього), щоб close_on_empty ніколи не сховав фейковий rundll32.exe. FIRST CHECK
        -- у промпті (шлях не System32/SysWOW64 → score 0.95) відпрацює саме на цих рядках.
        ("Process Path" NOT ILIKE '%System32%rundll32.exe'
         AND "Process Path" NOT ILIKE '%SysWOW64%rundll32.exe')
        OR
        -- ГІЛКА 2: rundll32 з ЛЕГІТИМНОГО шляху — показуємо ЛИШЕ справжній зовнішній вихід.
        -- Заміряно: 99% обсягу — rundll32, що хостить DLL легітимного LOB-застосунку і йде на
        -- ВНУТРІШНІ сервіси (найбільше 172.17.61.144:1433 та :3030 — MS SQL через ODBC), плюс
        -- наші ж публічні діапазони (rundll32 tsworkspace/RemoteApp на 188.163.216.101:443 —
        -- наш опублікований шлюз). Знімаємо внутрішні та наші адреси; коли зовнішнього нічого
        -- не лишилось (локальний AppX/COM rundll32 без egress), close_on_empty автозакриває.
        (NOT INCIDR('10.0.0.0/8', destinationip)
         AND NOT INCIDR('172.16.0.0/12', destinationip)
         AND NOT INCIDR('192.168.0.0/16', destinationip)
         AND NOT INCIDR('188.163.216.96/28', destinationip)
         AND NOT INCIDR('212.1.102.0/24', destinationip)
         AND NOT INCIDR('212.1.103.0/24', destinationip)
         AND NOT INCIDR('168.119.209.0/24', destinationip)
         AND destinationip != '82.207.23.25')
    )
    -- Свідомо НЕ вносимо в whitelist діапазони Microsoft/Azure/AWS: після зняття внутрішніх
    -- лишається ~20-30 рядків на добу по всій організації, і модель здатна відрізнити
    -- телеметрію Windows на 443 (verdict Benign_Windows_Telemetry) від сирого IP чи чистого
    -- HTTP на невідомий хост. Whitelist хмар засліпив би нас саме там, де реальний C2 і живе.
GROUP BY Host, "Process Path", destinationip, destinationport, username
ORDER BY Conns DESC
LIMIT {limit} {time_depth}
