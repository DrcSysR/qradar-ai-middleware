SELECT DATEFORMAT(starttime, 'MM-dd HH:mm:ss') AS Time,
       LOGSOURCENAME(logsourceid) AS LogSource,
       QIDNAME(qid) AS EventName,
       CATEGORYNAME(category) AS Category,
       username, sourceip, destinationip, destinationport,
       "Logon Type", "Action",
       UTF8(payload) AS RawPayload
FROM events
WHERE INOFFENSE({offense_id})
ORDER BY starttime DESC LIMIT {limit} {time_depth}
