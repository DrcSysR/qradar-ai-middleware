SELECT 
    QIDNAME(qid) AS Event_Name, 
    username AS Service_Account, 
    sourceip AS Source_IP, 
    destinationip AS Target_IP, 
    "Logon Type" AS Logon_Type,
    COUNT(*) AS Authentication_Attempts
FROM events 
WHERE 
    INOFFENSE({offense_id})
    /* Можна додати виключення довірених Jump-серверів адмінів, якщо вони є у Reference Set */
    AND NOT REFERENCESETCONTAINS('Windows Servers', destinationip) */
GROUP BY Event_Name, Service_Account, Source_IP, Target_IP, Logon_Type
ORDER BY Authentication_Attempts DESC
LIMIT {limit} {time_depth}